{
  "name": "sensibljs",
  "version": "1.7.0",
  "description": "Reactive UI in ~5KB gzipped (18KB minified). No build step. No virtual DOM. No dependencies. Just HTML attributes.",
  "keywords": [
    "reactive",
    "ui",
    "data-binding",
    "lightweight",
    "no-build",
    "html-attributes",
    "two-way-binding",
    "directives",
    "frontend",
    "vanilla-js",
    "no-dependencies",
    "declarative",
    "dom"
  ],
  "main": "sensibljs.js",
  "files": [
    "sensibljs.js",
    "sensibljs.min.js",
    "llms.txt",
    "llms-full.txt",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node test/sensibljs.test.js",
    "build": "babel sensibljs.js --no-comments > sensibljs.min.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricardoaponte/sensiblejs.git"
  },
  "author": "Ricardo Aponte Yunqué",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ricardoaponte/sensiblejs/issues"
  },
  "homepage": "https://github.com/ricardoaponte/sensiblejs#readme",
  "devDependencies": {
    "@babel/cli": "^7.12.1",
    "@babel/core": "^7.12.3",
    "babel-preset-minify": "^0.5.1",
    "jsdom": "^29.0.2"
  }
}
